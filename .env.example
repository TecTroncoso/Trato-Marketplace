# ── API (apps/api/.env) ─────────────────────────────────────────────
# La persistencia corre sobre libSQL (SQLite). Tres modos posibles:

# 1) Archivo local (default, sin configuración):
DATABASE_URL="file:./db/trato.db"

# 2) Turso remoto:
#    DATABASE_URL="libsql://<tu-db>-<org>.turso.io"   # o https:// para HTTP puro
#    TURSO_AUTH_TOKEN="<token>"

# 3) Réplica embebida (lecturas locales + escrituras al primario).
#    IMPORTANTE: solo en hosts con disco persistente (VPS/Render con disco).
#    NO en Vercel ni en tu máquina si el archivo ya existe como DB plana.
#    DATABASE_URL="file:./db/replica.db"
#    TURSO_SYNC_URL="libsql://<tu-db>-<org>.turso.io"
#    TURSO_AUTH_TOKEN="<token>"
#    TURSO_SYNC_INTERVAL=60000

TURSO_AUTH_TOKEN=
TURSO_SYNC_URL=
TURSO_SYNC_INTERVAL=60000

JWT_SECRET="trato-dev-secret-cambiar-en-produccion"
JWT_EXPIRES_IN="7d"
PORT=4000

WEB_ORIGIN=http://localhost:3000

# ── Web (apps/web/.env.local) ───────────────────────────────────────
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
