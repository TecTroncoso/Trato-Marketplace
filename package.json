{
  "name": "trato-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Trato - clon de Mercado Libre: Next.js 15 + NestJS + Prisma + Meilisearch",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @trato/api",
    "dev:web": "npm run dev -w @trato/web",
    "build": "npm run build -w @trato/shared && npm run build -w @trato/api && npm run build -w @trato/web",
    "start": "npm run start -w @trato/api",
    "db:push": "npm run db:push -w @trato/api",
    "db:generate": "npm run db:generate -w @trato/api",
    "db:studio": "npm run db:studio -w @trato/api",
    "db:info": "npm run db:info -w @trato/api",
    "db:reset": "npm run db:reset -w @trato/api",
    "seed": "npm run seed -w @trato/api",
    "search:reindex": "npm run search:reindex -w @trato/api",
    "search:serve": ".\\tools\\meilisearch.exe --master-key tratoMasterKeyDev --db-path .\\tools\\meili-data --http-addr 127.0.0.1:7700 --env development",
    "prepare": "npm run build -w @trato/shared"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
